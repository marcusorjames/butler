#!/bin/bash
# site subcommand

PACKAGE="butler site"

print_usage() {
  echo "Manage sites"
  echo " "
  echo "Usage:  $PACKAGE COMMAND [OPTIONS]"
  echo " "
  echo -e "${Yellow}Commands:"
  echo -e ""
  echo -e "  ${Green}add     ${Color_Off}add a new site"
  echo -e "  ${Green}list    ${Color_Off}list all sites"
  echo -e "  ${Green}clone   ${Color_Off}clone a repo and link it to an existing site"
  echo -e "  ${Green}cd      ${Color_Off}change directory to a site"
  echo -e "  ${Green}convert ${Color_Off}convert single-project site to multi-project"
  echo -e "  ${Green}status  ${Color_Off}show status of site(s)"
  echo -e "  ${Green}link    ${Color_Off}link or repair app symlinks"
  echo -e ""
  echo -e "  ${Green}-h, --help ${Color_Off}display this help"
}

[ ! "$#" -gt 0 ] && print_usage && exit 1
[ "$1" = "-h" ] || [ "$1" = "--help" ] && print_usage && exit 0

function="$1"
shift

case $function in
'add') . "$BIN_DIR/site-add" && main "$@" ;;
'list') . "$BIN_DIR/site-list" && main "$@" ;;
'clone') . "$BIN_DIR/site-clone" && main "$@" ;;
'cd') "$BIN_DIR/site-cd" "$@" ;;
'convert') . "$BIN_DIR/site-convert" && main "$@" ;;
'status') . "$BIN_DIR/site-status" && main "$@" ;;
'link') . "$BIN_DIR/site-link" && main "$@" ;;
*)
  print_usage && exit 1
  ;;
esac

#!/bin/bash
# scripts subcommand — list available scripts for the current site

PACKAGE="butler scripts"

. "$COMMON_DIR/functions.sh"

print_usage() {
  echo "List available scripts for the current site"
  echo " "
  echo "SYNOPSIS:"
  echo " "
  echo "$PACKAGE"
  echo " "
  echo "  -h, --help    print this help"
}

main() {
  [ "$1" = "-h" ] || [ "$1" = "--help" ] && print_usage && exit 0

  local site_scripts="$CURRENT_SITE_DIR/scripts"
  local global_scripts="$ROOT_DIR/scripts"
  local found=false
  local name

  if [ -d "$site_scripts" ]; then
    for script in "$site_scripts"/*; do
      [ -f "$script" ] || continue
      name="$(basename "$script")"
      [ -f "$BIN_DIR/$name" ] && continue
      echo -e "  ${Green}$name${Color_Off}"
      found=true
    done
  fi

  for script in "$global_scripts"/*; do
    [ -f "$script" ] || continue
    name="$(basename "$script")"
    [ -f "$site_scripts/$name" ] && continue
    [ -f "$BIN_DIR/$name" ] && continue
    echo -e "  ${Green}$name${Color_Off} ${Yellow}(global)${Color_Off}"
    found=true
  done

  $found || echo "No scripts available for this site"
}

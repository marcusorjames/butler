#!/bin/bash
# A dev stack builder, Install and manage your dev stack.
# Manage multiple PHP versions, automatically serve any folder

package="butler"
SOURCE="$0"
while [ -L "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
ROOT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
BIN_DIR="$ROOT_DIR/bin"
COMMON_DIR="$BIN_DIR/common"
. "$COMMON_DIR/init.sh"
. "$COMMON_DIR/colours.sh"
. "$COMMON_DIR/functions.sh"

export BUTLER_PROJECT="${BUTLER_PROJECT:-$(basename "$PWD")}"

# PATH any common binarys
export PATH="$PATH:$COMMON_DIR"

print_usage() {
  echo "butler version 0.1.0 - your friendly dev stack helper"
  echo " "
  echo "Usage:  $package COMMAND [SITE] [OPTIONS]"
  echo " "
  echo -e "${Yellow}Site management:"
  echo -e ""
  echo -e "  ${Green}site add             ${Color_Off}add a new site"
  echo -e "  ${Green}site list            ${Color_Off}list all sites"
  echo -e "  ${Green}site clone           ${Color_Off}clone a repo and link it to an existing site"
  echo -e "  ${Green}site cd              ${Color_Off}change directory to a site"
  echo -e "  ${Green}site convert         ${Color_Off}convert single-project site to multi-project"
  echo -e "  ${Green}site status          ${Color_Off}show status of site(s)"
  echo -e "  ${Green}site link            ${Color_Off}link or repair app symlinks"
  echo -e ""
  echo -e "${Yellow}Site commands ${Color_Off}(butler COMMAND [SITE] [OPTIONS]):"
  echo -e ""
  echo -e "  ${Green}up                   ${Color_Off}create and start container stack"
  echo -e "  ${Green}down                 ${Color_Off}stop container stack"
  echo -e "  ${Green}restart              ${Color_Off}restart container stack"
  echo -e "  ${Green}exec                 ${Color_Off}execute a command in the app container"
  echo -e "  ${Green}php                  ${Color_Off}run php in the app container"
  echo -e "  ${Green}exect                ${Color_Off}execute a command in the app container (no TTY)"
  echo -e "  ${Green}shell                ${Color_Off}open a shell in the app container"
  echo -e "  ${Green}composer             ${Color_Off}run composer in the app container"
  echo -e "  ${Green}run                  ${Color_Off}run a custom script"
  echo -e "  ${Green}scripts              ${Color_Off}list available scripts for the current site"
  echo -e "  ${Green}proxy                ${Color_Off}proxy site through ngrok"
  echo -e "  ${Green}docker-compose       ${Color_Off}docker compose passthrough"
  echo -e ""
  echo -e "${Yellow}Other commands:"
  echo -e ""
  echo -e "  ${Green}dns                  ${Color_Off}manage automatic DNS resolution"
  echo -e "  ${Green}templates            ${Color_Off}list available site templates"
  echo -e "  ${Green}ftp                  ${Color_Off}run an ephemeral FTP server"
  echo -e "  ${Green}sftp                 ${Color_Off}run an ephemeral SFTP server"
  echo -e "  ${Green}mysql                ${Color_Off}open a MySQL shell"
  echo -e ""
  echo -e "  ${Green}-h, --help           ${Color_Off}display this help"
}

[ ! "$#" -gt 0 ] && print_usage && exit 1
[ "$1" = "-h" ] || [ "$1" = "--help" ] && print_usage && exit 0

init

function="$1"
shift

HOST_UID=$(id -u)
export HOST_UID
HOST_GID=$(id -g)
export HOST_GID

# Non-site-aware commands skip site resolution; everything else resolves
case $function in
site | ftp | sftp | mysql | dns | templates | _complete) ;;
*) resolve_site "$1" && shift ;;
esac

# Container-targeting commands resolve which container to use
case $function in
exec | php | exect | shell | composer)
  resolve_container "$1" && shift
  ;;
esac

case $function in
'site') . "$BIN_DIR/site" "$@" ;;

# Site commands (site resolved above)
'up') . "$BIN_DIR/docker-compose" up "$@" ;;
'down') . "$BIN_DIR/docker-compose" down "$@" ;;
'restart') . "$BIN_DIR/docker-compose" restart "$@" ;;
'exec') . "$BIN_DIR/docker-compose" exec "${BUTLER_APP_CONTAINER}" "$@" ;;
'php') . "$BIN_DIR/docker-compose" exec "${BUTLER_APP_CONTAINER}" php "$@" ;;
'exect') . "$BIN_DIR/docker-compose" exec -T "${BUTLER_APP_CONTAINER}" "$@" ;;
'shell') . "$BIN_DIR/docker-compose" exec "${BUTLER_APP_CONTAINER}" bash "$@" ;;
'composer') . "$BIN_DIR/composer" "$@" ;;
'run') . "$BIN_DIR/run" "$@" ;;
'scripts') . "$BIN_DIR/scripts" && main "$@" ;;
'proxy') . "$BIN_DIR/proxy" "$@" ;;
'docker-compose') . "$BIN_DIR/docker-compose" "$@" ;;

# Other
'dns') . "$BIN_DIR/dns" && main "$@" ;;
'templates') . "$BIN_DIR/templates" "$@" ;;
'ftp') . "$BIN_DIR/ftp" "$@" ;;
'sftp') . "$BIN_DIR/sftp" "$@" ;;
'mysql') . "$BIN_DIR/mysql" "$@" ;;
'_complete') . "$BIN_DIR/_complete" "$@" ;;

*)
  if [ -f "$CURRENT_SITE_DIR/scripts/$function" ] || [ -f "$ROOT_DIR/scripts/$function" ]; then
    . "$BIN_DIR/run" "$function" "$@"
  else
    print_usage && exit 1
  fi
  ;;
esac
